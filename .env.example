# Referencia de variables de entorno. Copiá este archivo a .env.local
# (que no se sube al repo) y completá los valores.

# ID del Meta Pixel. Es pública (va al navegador), por eso lleva NEXT_PUBLIC_.
# Solo se usa en producción: en desarrollo local el pixel no se carga.
# Cargarla también en Vercel (Production y Preview).
NEXT_PUBLIC_META_PIXEL_ID=1386375903665255

# Las siguientes son solo de servidor: no les pongas el prefijo NEXT_PUBLIC_.

# Webhook de n8n que recibe el formulario de Hablanos (/api/contacto)
N8N_WEBHOOK_URL=
# Se manda en el header x-webhook-secret para que n8n valide el origen
N8N_WEBHOOK_SECRET=