# Referencia de variables de entorno. Copiá este archivo a .env.local
# (que no se sube al repo) y completá los valores. Son solo de servidor:
# no les pongas el prefijo NEXT_PUBLIC_.

# Webhook de n8n que recibe el formulario de Hablanos (/api/contacto)
N8N_WEBHOOK_URL=
# Se manda en el header x-webhook-secret para que n8n valide el origen
N8N_WEBHOOK_SECRET=
